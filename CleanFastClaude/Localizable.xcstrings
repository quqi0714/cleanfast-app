        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕斷食時鐘"
          }
        }
      }
    },
    "轻断食时钟仅用于计时与提醒，不提供医疗建议。\n若你有特殊健康情况，或计划进行较长时间断食，\n请先咨询专业人士。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CleanFast is a timer and reminder — not medical advice.\nIf you have a health condition, or plan to fast for an extended period,\nplease consult a professional first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻断食时钟仅用于计时与提醒，不提供医疗建议。\n若你有特殊健康情况，或计划进行较长时间断食，\n请先咨询专业人士。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕斷食時鐘僅用於計時與提醒，不提供醫療建議。\n若你有特殊健康狀況，或計畫進行較長時間斷食，\n請先諮詢專業人士。"
          }
        }
      }
    },
